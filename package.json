{
  "name": "imageapi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Node.js image generation platform with a vanilla JavaScript workspace.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test tests/node/*.test.js",
    "test:browser": "playwright test",
    "check": "node scripts/check.js",
    "format": "prettier --write server frontend tests scripts playwright.config.js",
    "format:check": "prettier --check server frontend tests scripts playwright.config.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "fontkit": "^2.0.4",
    "ipaddr.js": "^2.5.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "prettier": "^3.8.0",
    "supertest": "^7.2.0"
  }
}
