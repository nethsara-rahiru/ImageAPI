# Optional settings. Export them in the shell or use uvicorn --env-file .env.
IMAGEAPI_DATA_DIR=./data
IMAGEAPI_PUBLIC_ORIGIN=http://127.0.0.1:8000
IMAGEAPI_SECURE_COOKIES=false
# Optional stable Fernet key. If unset, a local data/encryption.key is created.
# Back up this key securely; losing it makes provider keys unreadable.
# IMAGEAPI_ENCRYPTION_KEY=
# Each user adds provider keys in Settings. No platform OPENAI_API_KEY is used.
