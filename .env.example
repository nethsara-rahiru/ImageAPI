# npm start loads .env automatically. Copy this file to .env to customize.
HOST=127.0.0.1
PORT=8080
IMAGEAPI_PUBLIC_ORIGIN=http://127.0.0.1:8080
IMAGEAPI_SECURE_COOKIES=false
IMAGEAPI_DATA_DIR=./data
# Optional base64url-encoded 32-byte key. Otherwise data/encryption.key is created.
# IMAGEAPI_ENCRYPTION_KEY=
# Users enter their own provider credentials in Settings. No global AI key is used.
